# Public canonical URL of the deployment (used for metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- "Build with us" form delivery -------------------------------------
# Configure at least ONE of the following, or the form will honestly report
# that it is not connected (and point people to Instagram instead).

# 1) Any HTTPS webhook that accepts JSON (Slack/Discord/Zapier/Make/Apps Script…)
CONTACT_WEBHOOK_URL=

# 2) Email via Resend (https://resend.com). Both values required.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="The Last Page <forms@your-verified-domain.com>"

# 3) Append submissions to .data/submissions.ndjson — only for self-hosted
#    servers with a persistent disk. Always on in `next dev`.
CONTACT_STORE=
